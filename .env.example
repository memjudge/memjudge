# Copy to .env and fill in only the keys you need. .env is ignored by git.
# Use with: memjudge run ... --env-file .env

# Judge: one key, matching the route in --judge (anthropic: / openai: / google: / openrouter:)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Memory systems: only for the connector you run (baselines/bm25 and offline/replay need none)
MEM0_API_KEY=
MEM0_OSS_OPENAI_API_KEY=
ZEP_API_KEY=
SUPERMEMORY_API_KEY=
LETTA_API_KEY=
RECALLD_API_KEY=
